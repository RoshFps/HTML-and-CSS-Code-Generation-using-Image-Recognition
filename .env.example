# Copy to .env and fill in. Never commit the real .env file.

# Optional: enables AI-generated CSS. Without it a built-in stylesheet is used.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Path to tensorflow/models/research (TensorFlow Object Detection API)
TF_MODELS_RESEARCH_DIR=/path/to/models/research

# Trained detector and label map
MODEL_PATH=frozen_inference_graph_816.pb
LABELS_PATH=labels.pbtxt

MAX_UPLOAD_MB=8
FLASK_DEBUG=0
